DATABASE_URL=postgres://user:password@localhost:5432/connectomic_medical_academy
JWT_SECRET=change-this-to-a-long-random-string
PORT=4100

# Optional SMTP config for real OTP emails (used only if the account has
# no phone number). Without these set, OTPs are printed to the server
# console (and echoed in the API response, clearly marked dev-only) so you
# can develop/test without an email provider.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASS=your-smtp-password
# SMTP_FROM="Connectomic Medical Academy <no-reply@example.com>"

# Optional Twilio config for real OTP SMS (used whenever the account has a
# phone number). Same dev-console fallback applies if unset. Sign up at
# twilio.com for ~$15 free trial credit -- trial accounts can only text
# numbers you've manually verified in the Twilio console until you add
# billing.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_PHONE_NUMBER=+15551234567
